{
  "apphosting": [
    {
      "backendId": "embrace",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "scratch",
        "docs",
        "data/eval/kpai.json",
        "data/eval/dinsos_demak.json",
        "agencies/*/sop/*.pdf",
        "functions",
        "video",
        "reference"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}