# Gemini API key (Google AI Studio). On App Hosting it comes from Secret Manager, see apphosting.yaml.
GOOGLE_GENAI_API_KEY=
# memory (default, local) or firestore
EMBRACE_STORE=memory
# Firebase web config (Analytics in the browser). Optional locally; on App Hosting see apphosting.yaml.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
